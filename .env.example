# academy-core. Empty by design. Copy to .env.local ONLY for a confirmed, isolated target.
# The API reads these three variables. HTTPS except for loopback in local development.
API_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional local listener (default 3000). Set NODE_ENV=production on any approved deployment.
PORT=

# Management-plane inventory ONLY. Do not provision these in the API/function environment.
# Run migrations with separately approved, scoped access in the owner-managed secret store.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_DEPLOYMENT_TOKEN=

# Future integrations. NONE are read by the runtime. Supplying values cannot enable them.
# OAuth grants/refresh tokens belong in an encrypted per-account vault; *_REF denotes a reference.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ID=
META_IG_PROFESSIONAL_ACCOUNT_ID=
META_PAGE_TOKEN_REF=
META_AD_ACCOUNT_ID=
META_ADS_TOKEN_REF=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REFRESH_TOKEN_REF=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_REF=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN_REF=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
SMS_DELIVERY_SIGNING_SECRET=
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_PUBLIC_KEY=
PAYMENT_SERVER_SECRET=
PAYMENT_WEBHOOK_SIGNING_SECRET=
OPENAI_PROJECT_API_KEY=
OPENAI_MODEL=
OPENAI_BUDGET_LIMIT=
LIVE_CLASS_PROVIDER=
LIVE_CLASS_OAUTH_CLIENT_ID=
LIVE_CLASS_OAUTH_CLIENT_SECRET=
LIVE_CLASS_TOKEN_REF=
LIVE_CLASS_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
