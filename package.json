{
  "name": "academy-core-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test tests/database.test.ts",
    "docs:api": "tsx scripts/openapi.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && tsx scripts/openapi.ts --check && tsx scripts/schema.ts --check",
    "lint": "eslint src api tests scripts",
    "format:check": "prettier --check src api tests scripts",
    "docs:schema": "tsx scripts/schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
